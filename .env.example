# 複製為 .env 後填入實際值，.env 本身不進版控。

# 審核後台（/admin/review）與相關 API 的 HTTP Basic Auth，見 proxy.ts。
# 未設定時 proxy.ts 會直接回絕（503），不會靜默放行。
ADMIN_USER=
ADMIN_PASSWORD=

# Phase 5 起，UGC 投稿資料改存 PostgreSQL（取代 data/contributions.json）。
# 格式：postgresql://<user>:<password>@<host>:<port>/<database>
# 首次部署需先執行 `pnpm run db:migrate` 建立資料表，見 配音擂台-infra.md。
DATABASE_URL=
